# Copy this file to .env and fill it in. .env is ignored by git; never commit it.
# Step-by-step instructions are in SETUP.md.

# PayPal SANDBOX app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# A sandbox test card (developer.paypal.com > Testing Tools > Credit Card Generator).
# Expiry is YYYY-MM and must be in the future.
PAYPAL_TEST_CARD_NUMBER=
PAYPAL_TEST_CARD_EXPIRY=
PAYPAL_TEST_CARD_CVV=
PAYPAL_TEST_CARD_NAME=Test Buyer

# Anthropic API key (console.anthropic.com). Needed only for --subject claude
# and --attacker adaptive.
ANTHROPIC_API_KEY=

# Optional model overrides. Both default to claude-opus-5-5.
# CRASHTEST_SUBJECT_MODEL=
# CRASHTEST_ATTACKER_MODEL=
